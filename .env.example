# If using project Docker Postgres (npm run docker:up): port 5433
DATABASE_URL="postgresql://symport:symport@localhost:5433/symport"

# Required for document extraction
OPENAI_API_KEY="sk-..."
# Optional: extraction model (must support vision). Default: gpt-4o
# OPENAI_EXTRACTION_MODEL="gpt-4o"        # default, good balance
# OPENAI_EXTRACTION_MODEL="gpt-4o-mini"   # cheaper, faster
# OPENAI_EXTRACTION_MODEL="gpt-4o-2024-11-20"  # specific version

# Required for Wiskr chat (multi-model LLM routing)
OPENROUTER_API_KEY="sk-or-v1-..."

# Required for next-auth JWT signing — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Required in production — set to your canonical URL (e.g. https://your-app.netlify.app)
NEXTAUTH_URL="http://localhost:3000"

# Registration gate — set to "true" to allow new accounts.
# Leave unset (or set to anything else) to block public sign-ups.
# ALLOW_REGISTRATION="true"

# Bunny.net file storage (required for image/PDF uploads)
# Create a Storage Zone in the Bunny dashboard, then attach a Pull Zone to it.
BUNNY_STORAGE_ZONE="your-storage-zone-name"
BUNNY_STORAGE_API_KEY="your-storage-zone-password"
BUNNY_CDN_URL="https://your-pull-zone.b-cdn.net"
# Optional: storage region hostname (default: storage.bunnynet.com)
# Other options: ny.storage.bunnynet.com, uk.storage.bunnynet.com,
#                la.storage.bunnynet.com, sg.storage.bunnynet.com
# BUNNY_STORAGE_HOSTNAME="storage.bunnynet.com"

# Sentry error tracking (https://sentry.io)
# NEXT_PUBLIC prefix makes the DSN available in the browser bundle (safe — DSNs are public)
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
# Optional: set in Netlify build env vars to upload source maps for readable stack traces
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="your-sentry-project"
# SENTRY_AUTH_TOKEN="sntrys_..."

# Resend email (required for password reset)
# Verify your sending domain at https://resend.com — or use onboarding@resend.dev for testing
RESEND_API_KEY="re_..."
RESEND_FROM="noreply@yourdomain.com"
