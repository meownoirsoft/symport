generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Document {
  id            String   @id @default(cuid())
  imagePath     String?  // relative path under uploads dir; null for note-only docs
  noteText      String?  // raw text for note docs (no image)
  status        String   @default("pending") // pending | paid | unpaid | submitted | reimbursed | not_eligible
  rotation      Int      @default(0) // display rotation in degrees: 0, 90, 180, 270
  extractedData Json     // type-specific JSON from AI
  searchText    String?  // denormalized text for full-text search (summary + key fields)
  embedding     Unsupported("vector(1536)")? // pgvector for semantic search (Wiskr)
  tags         String[] @default([]) // AI-suggested + user-editable labels (e.g. medical, receipt, tax)
  extractionNotes String? // user feedback to improve extraction or correct mistakes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- Wiskr: multi-model chat on top of Symport context ---

model Persona {
  id          String   @id @default(cuid())
  name        String   // "Spark", "Quest", etc.
  displayName String
  modelString String   // OpenRouter model id, e.g. google/gemini-2.5-flash
  provider    String
  description String?
  costTier    String   // cheap | mid | expensive
  avatarUrl   String?
  createdAt   DateTime @default(now())
  messages    Message[]
}

model Conversation {
  id                    String    @id @default(cuid())
  title                 String?
  parentConversationId  String?
  parentConversation    Conversation?  @relation("BranchConversations", fields: [parentConversationId], references: [id])
  branches              Conversation[] @relation("BranchConversations")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  contexts              ConversationContext[]
  messages              Message[]
  branchCards           BranchCard[]     @relation("SourceConversation")
  branchConversations   BranchCard[]     @relation("BranchConversation")
  nextQuestions         NextQuestion[]
  savedPrompts          SavedPrompt[]
}

model ConversationContext {
  conversationId String
  contextId      String   // Symport category label: "Medical", "Vehicle", etc.
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@id([conversationId, contextId])
}

model Message {
  id                 String   @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               String   // user | assistant
  content            String
  personaId          String?
  persona            Persona? @relation(fields: [personaId], references: [id])
  createdAt          DateTime @default(now())
  embedding          Unsupported("vector(1536)")?
  activeContextIds   Json?    // context IDs active when this message was sent (string[])
  capturedResponses CapturedResponse[]
  branchCardsAsSource BranchCard[]
}

model CapturedResponse {
  id                 String   @id @default(cuid())
  messageId          String
  message            Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content            String
  addedToContextId   String?  // context label the content was added to
  createdAt          DateTime @default(now())
}

model BranchCard {
  id                    String    @id @default(cuid())
  sourceConversationId  String
  sourceConversation    Conversation @relation("SourceConversation", fields: [sourceConversationId], references: [id], onDelete: Cascade)
  sourceMessageId       String?
  sourceMessage         Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  triggerText           String?
  conversationId       String?   // set when opened as side conversation
  branchConversation    Conversation? @relation("BranchConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  status                String    @default("pending") // pending | active | dismissed
  createdAt             DateTime  @default(now())
}

model SavedPrompt {
  id                   String        @id @default(cuid())
  content              String
  sourceConversationId String?
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
}

model NextQuestion {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/// Generic key-value store for app-wide settings.
/// Replaces the filesystem-based data/category-overrides.json.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Short-lived token for the password-reset flow. Expires after 1 hour.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
